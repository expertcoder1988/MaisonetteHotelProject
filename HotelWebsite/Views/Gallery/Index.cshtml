<script>
    $(document).ready(function () {
        $(".filtr-button").on("click", function () {
            var filterValue = $(this).attr("data-filter");

            // Update active class
            $(".filtr-button").removeClass("active"); // Remove active class from all buttons
            $(this).addClass("active"); // Add active class to clicked button

            if (filterValue === "all") {
                $(".filtr-item").show();
            } else {
                $(".filtr-item").hide();
                $('.filtr-item[data-category="' + filterValue + '"]').show();
            }
        });
    });
</script>