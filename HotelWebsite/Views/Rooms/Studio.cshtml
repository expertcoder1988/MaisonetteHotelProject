
@{
    ViewBag.Title = "Studio Room in Murree | Cozy Stay at Maisonette Firhill";
    ViewBag.keywords = "cozy room in Murree, couple-friendly room in Murree, affordable hotel in Murree, Maisonette Firhill accommodation, compact room in Murree";
    ViewBag.canonical = "https://maisonettefirhillmurree.com/studio-room-in-murree";
    ViewBag.Description = "Discover a perfect retreat in our Studio Room in Murree at Maisonette Firhill Hotel. Ideal for couples or solo travelers, with modern amenities & cozy ambiance.";
}


<main>
    <!-- properties gallery start -->
    <div class="hero full-height jarallax" data-jarallax data-speed="0.2">
        <img class="jarallax-img kenburns" src="~/Content/paradise/img/roomspic/Studio.png" alt="Murree hotel">
        <div class="wrapper opacity-mask d-flex align-items-center  text-center animate_hero" data-opacity-mask="rgba(0, 0, 0, 0.5)">
            <div class="container" style="margin-top:12%">
                <div class="row justify-content-center">
                    <div class="col-lg-8">
                        <small class="slide-animated one">Cozy and Chic</small>
                        <h1 class="slide-animated two">Book Studio Room in Murree</h1>
                        <p class="slide-animated three">Perfect for Couples or Solo Travelers</p>
                    </div>
                </div>
            </div>
            <div class="mouse_wp slide-animated four">
                <a href="#first_section" class="btn_explore">
                    <div class="mouse"></div>
                </a>
            </div>
            <!-- / mouse -->
        </div>
    </div>
    <!-- /Background Img Parallax -->

    <div class="bg_white" id="first_section">
        <div class="container margin_120_95">
            <div class="row justify-content-between">
                <div class="col-lg-4">
                    <div class="title">
                        <small>Comfort Meets Modern Amenities</small>
                        <h2>
                            Discover Affordable Luxury at Maisonette’s
                            Studio Room in Murree

                        </h2>
                    </div>
                    <p>
                        The Studio Room in Murree at Maisonette Firhill Hotel & Resort, offers the perfect blend of comfort and simplicity. Ideal for solo travelers or couples, this room features stylish interiors, a plush bed, and all essential amenities, including free Wi-Fi, a smart TV, and a coffee maker. The compact yet functional design ensures a cozy and relaxing stay. Step onto the shared balcony to enjoy fresh mountain air and serene views, making your Murree getaway truly unforgettable.
                    </p>
                </div>

                <div class="col-lg-6">
                    <div class="room_facilities_list">
                        <ul data-cues="slideInLeft">
                            <li><i class="icon-hotel-parking"></i> Parking</li>
                            <li><i class="icon-hotel-wifi"></i> High Speed Wifi</li>
                            <li><i class="icon-hotel-room_service"></i> Room Service</li>
                            <li><i class="icon-hotel-restaurant"></i>In-House Restaurant</li>
                            <li><i class="icon-hotel-info"></i> Wake Up Call</li>
                            <li><i class="icon-hotel-bottle"></i> Water Bottle</li>
                            <li><i class="icon-hotel-hairdryer"></i> Hair Dryer</li>
                            <li><i class="icon-hotel-safety_box"></i> Safe </li>
                            <li><i class="icon-hotel-tv"></i>LED TV</li>
                            <li><i class="icon-hotel-loundry"></i>Toiletries</li>
                            <li><i class="icon-hotel-disable"></i> WheelChair Access</li>
                        </ul>
                    </div>
                </div>
            </div>
            <!-- /row -->
        </div>
        <!-- /container -->
    </div>
    <!-- /bg_white -->



</main>

