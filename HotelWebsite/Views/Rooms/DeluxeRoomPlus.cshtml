
@{
    ViewBag.Title = "Book Deluxe Room with a View at Hotel Home Naran, Pakistan";
    ViewBag.keywords = "Deluxe room  rooms in Naran, rooms with a view, room with a view, hotels in Naran Pakistan, Naran hotel room rent, Hotel home Naran, hotels in Naran, Naran hotels rates";
    ViewBag.canonical = "https://maisonettefirhillmurree.com/rooms/deluxe-room";
    ViewBag.Description = "Deluxe room at Hotel Home Naran offers luxurious beds and all the amenities. Book deluxe rooms with a view at the best family hotel in Naran Kaghan Valley. ";
}


<main>
    <!-- properties gallery start -->
    <div class="hero full-height jarallax" data-jarallax data-speed="0.2">
        <img class="jarallax-img kenburns" src="~/Content/paradise/img/rooms/DeluxePlus.png" alt="">
        <div class="wrapper opacity-mask d-flex align-items-center  text-center animate_hero" data-opacity-mask="rgba(0, 0, 0, 0.5)">
            <div class="container">
                <div class="row justify-content-center">
                    <div class="col-lg-8">
                        <h1 class="slide-animated two">Business Suite – Hotel Home Naran</h1>
                    </div>
                </div>
            </div>
            <div class="mouse_wp slide-animated four">
                <a href="#first_section" class="btn_explore">
                    <div class="mouse"></div>
                </a>
            </div>
            <!-- / mouse -->
        </div>
    </div>
    <!-- /Background Img Parallax -->

    <div class="bg_white" id="first_section">
        <div class="container margin_120_95">
            <div class="row justify-content-between">
                <div class="col-lg-4">
                    <div class="title">
                        <small>Luxury Experience</small>
                        <h2>Deluxe Room Plus – Hotel Home Naran.</h2>
                    </div>
                    <p>Unwind in luxury at Hotel Home in Naran, Pakistan, in our Deluxe Room Plus. Our spacious rooms at Naran Hotel offer comfortable stays featuring soft linens and premium amenities. Wake up to stunning views of the natural beauty outside your window as you sip on your morning coffee or tea. Our Naran Hotel boasts rooms with a view that will leave you breathless. Relax in the seating area or catch up on your favorite TV shows on our flat-screen televisions. Plan your next adventure with our complimentary Wi-Fi, or enjoy the tranquil environment in your private sanctuary. Hotel Home offers an unforgettable experience for your getaway. Book your stay with us and feel right at home.</p>
                </div>
                <div class="col-lg-6">
                    <div class="room_facilities_list">
                        <ul data-cues="slideInLeft">
                            <li><i class="icon-hotel-parking"></i> Parking</li>
                            <li><i class="icon-hotel-wifi"></i> High Speed Wifi</li>
                            <li><i class="icon-hotel-room_service"></i> Room Service</li>
                            <li><i class="icon-hotel-restaurant"></i>In-House Restaurant</li>
                            <li><i class="icon-hotel-info"></i> Wake Up Call</li>
                            <li><i class="icon-hotel-bottle"></i> Water Bottle</li>
                            <li><i class="icon-hotel-hairdryer"></i> Hair Dryer</li>
                            <li><i class="icon-hotel-safety_box"></i> Safe </li>
                            <li><i class="icon-hotel-tv"></i>LED TV</li>
                            <li><i class="icon-hotel-loundry"></i>Toiletries</li>
                            <li><i class="icon-hotel-disable"></i> WheelChair Access</li>
                        </ul>
                    </div>
                </div>
            </div>
            <!-- /row -->
        </div>
        <!-- /container -->
    </div>
    <!-- /bg_white -->



</main>

