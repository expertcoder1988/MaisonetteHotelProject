
@{
    ViewBag.Title = "Honeymoon Suite in Murree | Romantic Retreat at Maisonette ";
    ViewBag.keywords = "romantic suite in Murree, luxury honeymoon hotel in Murree, couple's suite in Murree, Maisonette Firhill Murree, romantic stay in Murree";
    ViewBag.canonical = "https://maisonettefirhillmurree.com/honeymoon-suite-in-murree";
    ViewBag.Description = "Celebrate love in our Honeymoon Suite in Murree at Maisonette Firhill Hotel. Enjoy luxurious furnishings, breathtaking views, and a romantic ambiance.";
}


<main>
    <!-- properties gallery start -->
    <div class="hero full-height jarallax" data-jarallax data-speed="0.2">
        <img class="jarallax-img kenburns" src="~/Content/paradise/img/roomspic/honeymoon.png" alt="Murree hotel">
        <div class="wrapper opacity-mask d-flex align-items-center  text-center animate_hero" data-opacity-mask="rgba(0, 0, 0, 0.5)">
            <div class="container" style="margin-top:12%">
                <div class="row justify-content-center">
                    <div class="col-lg-8">
                        <small class="slide-animated one">Enjoy a Romantic Retreat</small>
                        <h1 class="slide-animated two">
                            
                            Book Honeymoon Suite in Murree

                        </h1>
                        <p class="slide-animated three">Maisonette Firhill Hotel & Resort</p>
                    </div>
                </div>
            </div>
            <div class="mouse_wp slide-animated four">
                <a href="#first_section" class="btn_explore">
                    <div class="mouse"></div>
                </a>
            </div>
            <!-- / mouse -->
        </div>
    </div>
    <!-- /Background Img Parallax -->

    <div class="bg_white" id="first_section">
        <div class="container margin_120_95">
            <div class="row justify-content-between">
                <div class="col-lg-4">
                    <div class="title">
                        <small>Indulge in Luxury </small>
                        <h2>
                            Your Perfect Honeymoon Destination
                            at Maisonette Firhill Murree

                        </h2>
                    </div>
                    <p>
                        Celebrate your love story in the enchanting Honeymoon Suite in Murree at Maisonette Firhill Hotel & Resort. This elegantly designed suite exudes romance, featuring a king-sized bed, cozy seating area, and a private balcony with stunning views of the snow-capped hills. Indulge in luxury with modern amenities, a lavish bathroom, and personalized services to make your stay extra special. Whether it’s your honeymoon or an anniversary celebration, this suite offers the perfect romantic escape in the heart of Murree.
                    </p>
                </div>

                <div class="col-lg-6">
                    <div class="room_facilities_list">
                        <ul data-cues="slideInLeft">
                            <li><i class="icon-hotel-parking"></i> Parking</li>
                            <li><i class="icon-hotel-wifi"></i> High Speed Wifi</li>
                            <li><i class="icon-hotel-room_service"></i> Room Service</li>
                            <li><i class="icon-hotel-restaurant"></i>In-House Restaurant</li>
                            <li><i class="icon-hotel-info"></i> Wake Up Call</li>
                            <li><i class="icon-hotel-bottle"></i> Water Bottle</li>
                            <li><i class="icon-hotel-hairdryer"></i> Hair Dryer</li>
                            <li><i class="icon-hotel-safety_box"></i> Safe </li>
                            <li><i class="icon-hotel-tv"></i>LED TV</li>
                            <li><i class="icon-hotel-loundry"></i>Toiletries</li>
                            <li><i class="icon-hotel-disable"></i> WheelChair Access</li>
                        </ul>
                    </div>
                </div>
            </div>
            <!-- /row -->
        </div>
        <!-- /container -->
    </div>
    <!-- /bg_white -->



</main>

