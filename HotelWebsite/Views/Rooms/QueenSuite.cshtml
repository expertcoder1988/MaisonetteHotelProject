
@{
    ViewBag.Title = "Queen Suite in Murree | Spacious Family Stay at Maisonette ";
    ViewBag.keywords = "spacious family room in Murree, luxury suite in Murree, group-friendly room in Murree, Maisonette Firhill Hotel, family suite in Murree";
    ViewBag.canonical = "https://maisonettefirhillmurree.com/queen-suite-in-murree";
    ViewBag.Description = "Unwind in our Queen Suite in Murree at Maisonette Firhill Hotel. Perfect for families or groups, offering plush bedding, modern amenities & a serene ambiance.";
}


<main>
    <!-- properties gallery start -->
    <div class="hero full-height jarallax" data-jarallax data-speed="0.2">
        <img class="jarallax-img kenburns" src="~/Content/paradise/img/roomspic/queen.png" alt="">
        <div class="wrapper opacity-mask d-flex align-items-center  text-center animate_hero" data-opacity-mask="rgba(0, 0, 0, 0.5)">
            <div class="container" style="margin-top:12%">
                <div class="row justify-content-center">
                    <div class="col-lg-8">
                        <small class="slide-animated one">Spacious Elegance</small>
                        <h1 class="slide-animated two">Book Queen Suite in Murree</h1>
                        <p class="slide-animated three">Unwind with Loved Ones in Our Queen Suite at Maisonette Firhill Murree</p>
                    </div>
                </div>
            </div>
            <div class="mouse_wp slide-animated four">
                <a href="#first_section" class="btn_explore">
                    <div class="mouse"></div>
                </a>
            </div>
            <!-- / mouse -->
        </div>
    </div>
    <!-- /Background Img Parallax -->

    <div class="bg_white" id="first_section">
        <div class="container margin_120_95">
            <div class="row justify-content-between">
                <div class="col-lg-4">
                    <div class="title">
                        <small>Perfect for Families</small>
                        <h2>
                            Unwind with Loved Ones at Our Queen Suite
                            in Murree at Maisonette Firhill Murree

                        </h2>
                    </div>
                    <p>
                        The Queen Suite in Murree at Maisonette Firhill Hotel & Resort, redefines comfort and space for families or group travelers. This generously sized suite features a master bedroom with plush bedding, a separate living area, and a private balcony to enjoy the scenic beauty of Murree. Equipped with top-notch amenities like free Wi-Fi, a minibar, and a luxurious bathroom, the Queen Suite is designed to cater to your every need. Make lasting memories with your loved ones in this cozy and stylish retreat.
                    </p>
                </div>

                <div class="col-lg-6">
                    <div class="room_facilities_list">
                        <ul data-cues="slideInLeft">
                            <li><i class="icon-hotel-parking"></i> Parking</li>
                            <li><i class="icon-hotel-wifi"></i> High Speed Wifi</li>
                            <li><i class="icon-hotel-room_service"></i> Room Service</li>
                            <li><i class="icon-hotel-restaurant"></i>In-House Restaurant</li>
                            <li><i class="icon-hotel-info"></i> Wake Up Call</li>
                            <li><i class="icon-hotel-bottle"></i> Water Bottle</li>
                            <li><i class="icon-hotel-hairdryer"></i> Hair Dryer</li>
                            <li><i class="icon-hotel-safety_box"></i> Safe </li>
                            <li><i class="icon-hotel-tv"></i>LED TV</li>
                            <li><i class="icon-hotel-loundry"></i>Toiletries</li>
                            <li><i class="icon-hotel-disable"></i> WheelChair Access</li>
                        </ul>
                    </div>
                </div>
            </div>
            <!-- /row -->
        </div>
        <!-- /container -->
    </div>
    <!-- /bg_white -->



</main>

