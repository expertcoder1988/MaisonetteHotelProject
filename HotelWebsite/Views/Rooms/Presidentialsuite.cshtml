
@{
    ViewBag.Title = "Presidential Suite in Murree | Ultimate Luxury Maisonette ";
    ViewBag.keywords = "luxury suite in Murree, best hotel suite in Murree, premium suite in Murree, Maisonette Murree hotel, opulent stay in Murree, Murree resort accommodation";
    ViewBag.canonical = "https://maisonettefirhillmurree.com/presidential-suite-in-murree";
    ViewBag.Description = "Indulge in unmatched luxury in the Presidential Suite in Murree at Maisonette Firhill Hotel. Enjoy opulent décor, exclusive amenities, and panoramic hill views.";
}


<main>
    <!-- properties gallery start -->
    <div class="hero full-height jarallax" data-jarallax data-speed="0.2">
        <img class="jarallax-img kenburns" src="~/Content/paradise/img/roomspic/presin.png" alt="Murree hotel">
        <div class="wrapper opacity-mask d-flex align-items-center  text-center animate_hero" data-opacity-mask="rgba(0, 0, 0, 0.5)">
            <div class="container" style="margin-top:12%">
                <div class="row justify-content-center">
                    <div class="col-lg-8">
                        <small class="slide-animated one">Redefining Luxury Living</small>
                        <h1 class="slide-animated two">Book Presidential Suite in Murree</h1>
                        <p class="slide-animated three">Stay in Our Luxurious Suite at Maisonette Firhill Hotel & Resort</p>
                    </div>
                </div>
            </div>
            <div class="mouse_wp slide-animated four">
                <a href="#first_section" class="btn_explore">
                    <div class="mouse"></div>
                </a>
            </div>
            <!-- / mouse -->
        </div>
    </div>
    <!-- /Background Img Parallax -->

    <div class="bg_white" id="first_section">
        <div class="container margin_120_95">
            <div class="row justify-content-between">
                <div class="col-lg-4">
                    <div class="title">
                        <small>Opulence Awaits in the Heart of Murree</small>
                        <h2>
                            Experience Unparalleled Luxury
                            Presidential Suite in Murree at Maisonette Firhill Hotel

                        </h2>
                    </div>
                    <p>
                        Experience the pinnacle of luxury in the Presidential Suite in Murree at Maisonette Firhill Hotel & Resort. Designed for discerning guests, this suite offers opulent décor, a spacious layout, and exclusive amenities that redefine sophistication. Relax in the grand living area, rejuvenate in the lavish bathroom, and take in panoramic views of the picturesque Murree hills from your private balcony. With personalized services and state-of-the-art facilities, the Presidential Suite promises an unforgettable stay in Murree’s most luxurious setting.
                    </p>
                </div>

                <div class="col-lg-6">
                    <div class="room_facilities_list">
                        <ul data-cues="slideInLeft">
                            <li><i class="icon-hotel-parking"></i> Parking</li>
                            <li><i class="icon-hotel-wifi"></i> High Speed Wifi</li>
                            <li><i class="icon-hotel-room_service"></i> Room Service</li>
                            <li><i class="icon-hotel-restaurant"></i>In-House Restaurant</li>
                            <li><i class="icon-hotel-info"></i> Wake Up Call</li>
                            <li><i class="icon-hotel-bottle"></i> Water Bottle</li>
                            <li><i class="icon-hotel-hairdryer"></i> Hair Dryer</li>
                            <li><i class="icon-hotel-safety_box"></i> Safe </li>
                            <li><i class="icon-hotel-tv"></i>LED TV</li>
                            <li><i class="icon-hotel-loundry"></i>Toiletries</li>
                            <li><i class="icon-hotel-disable"></i> WheelChair Access</li>
                        </ul>
                    </div>
                </div>
            </div>
            <!-- /row -->
        </div>
        <!-- /container -->
    </div>
    <!-- /bg_white -->



</main>

