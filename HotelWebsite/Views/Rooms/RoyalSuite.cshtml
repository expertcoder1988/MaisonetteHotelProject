@{
    ViewBag.Title = "Book Online Royal Suite at Home Hotel Naran, Pakistan";
    ViewBag.keywords = "Royal Suite Rooms in Naran, rooms with a view, room with a view, hotels in Naran Pakistan, Naran hotel room rent, Hotel home Naran, hotels in Naran, Naran hotels rates";
    ViewBag.canonical = "https://maisonettefirhillmurree.com/rooms/royal-suite";
    ViewBag.Description = "Royal suite at Hotel Home Naran offers luxurious beds and all the amenities. Book online Royal Suite with a view at the luxury hotel in Naran Kaghan Valley.";
}


<main>
    <!-- properties gallery start -->
    <div class="hero full-height jarallax" data-jarallax data-speed="0.2">
        <img class="jarallax-img kenburns" src="~/Content/paradise/img/rooms/RoyalSuite.png" alt="">
        <div class="wrapper opacity-mask d-flex align-items-center  text-center animate_hero" data-opacity-mask="rgba(0, 0, 0, 0.5)">
            <div class="container">
                <div class="row justify-content-center">
                    <div class="col-lg-8">
                        <h1 class="slide-animated two">Royal Suite – Hotel Home Naran</h1>
                    </div>
                </div>
            </div>
            <div class="mouse_wp slide-animated four">
                <a href="#first_section" class="btn_explore">
                    <div class="mouse"></div>
                </a>
            </div>
            <!-- / mouse -->
        </div>
    </div>
    <!-- /Background Img Parallax -->

    <div class="bg_white" id="first_section">
        <div class="container margin_120_95">
            <div class="row justify-content-between">
                <div class="col-lg-4">
                    <div class="title">
                        <small>Luxury Experience</small>
                        <h2>Royal Suite – Hotel Home Naran .</h2>
                    </div>
                    <p>At Hotel Home Naran, we want you to feel like royalty while staying with us. That's why we offer our luxurious Royal Suite, a regal accommodation that promises to leave you feeling pampered and content. With spacious rooms, comfortable beds, and breathtaking views of the surrounding landscape, our Royal Suite is truly fit for a king or queen. Situated in our picturesque hotel in Naran, Pakistan, the Royal Suite provides guests a magical experience as they take in the snow-capped peaks, glistening streams, and lush greenery. Come and experience the grandeur of our Royal Suite, where you'll have everything you need to enjoy a truly indulgent stay.</p>
                </div>
                <div class="col-lg-6">
                    <div class="room_facilities_list">
                        <ul data-cues="slideInLeft">
                            <li><i class="icon-hotel-parking"></i> Parking</li>
                            <li><i class="icon-hotel-wifi"></i> High Speed Wifi</li>
                            <li><i class="icon-hotel-room_service"></i> Room Service</li>
                            <li><i class="icon-hotel-restaurant"></i>In-House Restaurant</li>
                            <li><i class="icon-hotel-info"></i> Wake Up Call</li>
                            <li><i class="icon-hotel-bottle"></i> Water Bottle</li>
                            <li><i class="icon-hotel-hairdryer"></i> Hair Dryer</li>
                            <li><i class="icon-hotel-safety_box"></i> Safe </li>
                            <li><i class="icon-hotel-tv"></i>LED TV</li>
                            <li><i class="icon-hotel-loundry"></i>Toiletries</li>
                            <li><i class="icon-hotel-disable"></i> WheelChair Access</li>
                        </ul>
                    </div>
                </div>
            </div>
            <!-- /row -->
        </div>
        <!-- /container -->
    </div>
    <!-- /bg_white -->



</main>

