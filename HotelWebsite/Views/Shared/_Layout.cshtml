    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const btn = document.getElementById("myBtn");
            const modal = document.querySelector(".popup_wrapper");
            const closeBtn = document.querySelector(".popup_close");

            // Show modal on button click
            btn.addEventListener("click", function () {
                modal.classList.add("active");
            });

            // Close modal on close button click
            closeBtn.addEventListener("click", function () {
                modal.classList.remove("active");
            });

            // Optional: Close modal when clicking outside the modal content
            window.addEventListener("click", function (e) {
                if (e.target === modal) {
                    modal.classList.remove("active");
                }
            });
        });
    </script>

    <script>
        // Get the desktop header
        window.addEventListener('scroll', function () {
            const headerInitial = document.getElementById('header-initial');
            const headerScroll = document.getElementById('header-scroll');

            // Check if the scroll position is greater than 50 pixels
            if (window.scrollY > 50) {
                // Add class to hide the initial header and show the scroll header
                headerInitial.classList.add('scrolled');
                headerScroll.style.display = 'block'; // Show scroll header
            } else {
                // Reset to initial state
                headerInitial.classList.remove('scrolled');
                headerScroll.style.display = 'none'; // Hide scroll header
            }
        });

    </script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const initialHeader = document.getElementById('header-initial');
            const scrollHeader = document.getElementById('header-scroll');

            // Function to show the appropriate header based on scroll position
            function handleHeaderDisplay() {
                const isLargeScreen = window.innerWidth > 768; // Adjust width as needed

                if (isLargeScreen && window.scrollY > 0) {
                    initialHeader.style.display = 'none'; // Hide initial header on large screens when scrolled
                    scrollHeader.style.display = 'block'; // Show scroll header on large screens
                } else {
                    initialHeader.style.display = 'block'; // Always show initial header on mobile
                    scrollHeader.style.display = 'none'; // Hide scroll header on mobile
                }
            }

            // Check initial scroll position when the page loads
            handleHeaderDisplay();

            // Add scroll event listener
            window.addEventListener('scroll', handleHeaderDisplay);

            // Add resize event listener to re-check screen size on resize
            window.addEventListener('resize', handleHeaderDisplay);
        });


    </script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const currentPath = window.location.pathname.toLowerCase();

            // Select all menu items
            const menuItems = document.querySelectorAll(".items_olist");

            menuItems.forEach(item => {
                const link = item.querySelector("a");

                if (link) {
                    const itemPath = new URL(link.href, window.location.origin).pathname.toLowerCase();

                    // Check if the href exactly matches the current path
                    if (currentPath === itemPath) {
                        // Remove active class from all items
                        menuItems.forEach(el => el.classList.remove("active"));

                        // Add active class to the matched item
                        item.classList.add("active");
                    }
                }
            });
        });

    </script>

    <script>
        function toggleDropdown() {
            const dropdownMenu = document.getElementById('dropdownMenu');
            dropdownMenu.classList.toggle('active');
        }

    </script>


    <script>
        // code for Feedback
        document.getElementById("feedbackForm").addEventListener("submit", async function (e) {
            e.preventDefault();

            const formData = new FormData(this);
            const feedbackData = {};

            // Only collect checked radio button values
            formData.forEach((value, key) => {
                if (!feedbackData[key]) {
                    feedbackData[key] = value;
                }
            });

            try {
                const response = await fetch("/Feedback/SendFeedbackEmail", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                    },
                    body: JSON.stringify(feedbackData),
                });

                if (response.ok) {
                    alert("Feedback submitted successfully!");
                } else {
                    alert("Error sending feedback.");
                }
            } catch (error) {
                alert("Error: " + error.message);
            }
        });

    </script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
</body>
</html>