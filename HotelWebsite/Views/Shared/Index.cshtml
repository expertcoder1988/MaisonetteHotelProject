<script>
    var modal = document.getElementById("myModal");
    var btn = document.getElementById("myBtn");
    var span = document.getElementsByClassName("close")[0];

    btn.onclick = function () {
        modal.style.display = "block";
    }

    span.onclick = function () {
        console.log("Close button clicked");
        modal.style.display = "none";
    }

    window.onclick = function (event) {
        if (event.target == modal) {
            modal.style.display = "none";
        }
    }
</script>

<script>
    function incrementQty(event) {
        event.preventDefault();
        console.log("Increment button clicked");
        const inputField = this.parentNode.querySelector('.qty');
        let currentValue = parseInt(inputField.value) || 0;
        inputField.value = currentValue + 1;
    }

    function decrementQty(event) {
        event.preventDefault();
        console.log("Decrement button clicked");
        const inputField = this.parentNode.querySelector('.qty');
        let currentValue = parseInt(inputField.value) || 0;
        if (currentValue > 0) {
            inputField.value = currentValue - 1;
        }
    }


</script>

<script>

    $(document).ready(function () {
        // Initialize the date range picker
        $('#DesktopDaterangePicker').daterangepicker({
            opens: 'left',
            locale: {
                format: 'YYYY MMM DD',
                separator: " to"
            },
            autoApply: true,
            autoUpdateInput: false,
            minDate: new Date(),
            endDate: new Date(),
            singleDatePicker: false,
            showCustomRangeLabel: false
        });

        // Event: When a date range is applied
        $('#DesktopDaterangePicker').on('apply.daterangepicker', function (ev, picker) {
            let selectedStartDate = picker.startDate.clone();
            let selectedEndDate = picker.endDate.clone();

            // Check if the start date and end date are the same
            if (selectedStartDate.isSame(selectedEndDate, 'day')) {
                selectedEndDate = selectedStartDate.clone().add(1, 'days'); // Add 1 day to the end date
                picker.setEndDate(selectedEndDate); // Update the picker end date
            }

            // Update the input field with the selected date range
            $(this).val(selectedStartDate.format('YYYY-MM-DD') + '  >  ' + selectedEndDate.format('YYYY-MM-DD'));

            // Update hidden input fields for form submission
            $('#CheckIn').val(selectedStartDate.format('YYYY-MM-DD'));
            $('#CheckOut').val(selectedEndDate.format('YYYY-MM-DD'));
        });

        // Event: When the cancel button is clicked
        $('#DesktopDaterangePicker').on('cancel.daterangepicker', function () {
            // Clear the input and hidden fields
            $(this).val('');
            $('#CheckIn').val('');
            $('#CheckOut').val('');
        });
    });


</script>


