<script>
    // Function to toggle the check icons
    document.querySelectorAll('.form__input').forEach(input => {
        input.addEventListener('change', function () {
            document.querySelectorAll('.form__label-check').forEach(svg => svg.style.display = 'none');
            if (input.checked) {
                input.closest('.form__label').querySelector('.form__label-check').style.display = 'inline';
            }
        });
    });

    // Initialize by showing the checked icon for the default checked radio button
    document.querySelector('.form__input:checked').closest('.form__label').querySelector('.form__label-check').style.display = 'inline';
</script>

<script>
    var isVoucherApplied = false; // Flag to check if the voucher is already applied

    function applyVoucher() {
        if (isVoucherApplied) {
            alert('Voucher has already been applied.');
            return;
        }

        var voucherCode = document.getElementById('voucherCode').value;
        var totalAmountField = document.getElementById('totalPriceCell');
        var hiddenVoucherCodeField = document.getElementById('hiddenVoucherCode');

        if (!totalAmountField || !hiddenVoucherCodeField) {
            console.error('Total Amount or Hidden Voucher Code field is not found');
            return;
        }

        $.ajax({
            url: '/SearchResult/GetDiscountAmount',
            type: 'POST',
            data: { code: voucherCode },
            success: function (response) {
                if (response.success) {
                    var totalAmount = parseFloat(totalAmountField.innerText.replace('Rs. ', '').replace(',', ''));
                    var discountAmount = response.discountAmount;
                    var newTotalAmount = totalAmount - discountAmount;

                    totalAmountField.innerText = newTotalAmount + '.PKR';

                    isVoucherApplied = true; // Set the flag to true after applying the voucher
                    // Set the hidden field value to the applied voucher code
                    hiddenVoucherCodeField.value = voucherCode;
                } else {
                    alert('Invalid voucher code');
                }
            },
            error: function () {
                alert('An error occurred while applying the voucher code.');
            }
        });
    }
</script>