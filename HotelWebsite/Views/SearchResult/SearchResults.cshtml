<script>
  $(document).ready(function () {
      // Iterate over each room-row to fetch and display policy data
      $('.room-row').each(function () {
          var $roomRow = $(this); // Current room-row element
          var cancellationPolicyId = $roomRow.data('policy-id'); // Fetch dynamic CancellationPolicyId

          // Make the AJAX call to fetch the policy details
          $.ajax({
              url: '@Url.Action("RoomPolicy", "SearchResult")', // Update with your actual controller name
              type: 'GET',
              data: { CancellationPolicy: cancellationPolicyId },
              success: function (response) {
                  console.log(`Response for policy ID ${cancellationPolicyId}:`, response); // Debugging

                  if (response && response.length > 0) {
                      var policy = response[0];

                      // Update the relevant tooltip fields dynamically
                      $roomRow.find('.HowlongFreeOfCharge').text(policy.HowlongFreeOfCharge || 'N/A');
                      $roomRow.find('.guestChargedForCancellation').text(policy.GuestChargedForCancellation || 'N/A');
                      $roomRow.find('.chargedForNoShow').text(policy.ChargedForNoShow || 'N/A');
                      $roomRow.find('.Breakfast').text(policy.Breakfast || 'N/A');

                  } else {
                      console.warn(`No policy data found for policy ID ${cancellationPolicyId}`);
                      $roomRow.find('.HowlongFreeOfCharge').text('N/A');
                      $roomRow.find('.guestChargedForCancellation').text('N/A');
                      $roomRow.find('.chargedForNoShow').text('N/A');
                      $roomRow.find('.breakfast').text('N/A'); // Default value for breakfast
                  }
              },
              error: function (error) {
                  console.error(`Error fetching policy data for policy ID ${cancellationPolicyId}:`, error);

                  // Handle error case (e.g., display default values)
                  $roomRow.find('.HowlongFreeOfCharge').text('N/A');
                  $roomRow.find('.guestChargedForCancellation').text('N/A');
                  $roomRow.find('.chargedForNoShow').text('N/A');
                  $roomRow.find('.breakfast').text('N/A'); // Default value for breakfast
              }
          });
      });
  });
    document.addEventListener("DOMContentLoaded", function () {
        // Add event listeners to each modal trigger
        const modalTriggers = document.querySelectorAll(".property-video");
        modalTriggers.forEach(trigger => {
            trigger.addEventListener("click", function () {
                // Get room data from attributes or hidden fields
                const roomCategory = this.getAttribute("data-room-category");
                const roomDescription = this.getAttribute("data-room-description");
                const videoLink = this.getAttribute("href");
                const image1 = this.getAttribute("data-image1");
                const image2 = this.getAttribute("data-image2");

                // Update modal content
                document.getElementById("modalRoomCategory").textContent = roomCategory;
                document.getElementById("modalRoomDescription").textContent = roomDescription;
                document.getElementById("vidFrame").src = videoLink;
                document.getElementById("carouselImage1").src = image1;
                document.getElementById("carouselImage2").src = image2;


            });
        });
    });
</script>

