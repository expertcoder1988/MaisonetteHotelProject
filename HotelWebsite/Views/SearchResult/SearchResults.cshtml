<script type="text/javascript">
    var $j = jQuery.noConflict();
    var value = 0;
    var totalAmount = 0;
    var DiscountedAmount = 0;

    $j(function () {
        // Handle Minus Button Click
        $j("input[name='CalculateMinus']").on('click', function () {
            var id = $j(this).data("value");
            var quantityInput = $j('#txtQuatntity_' + id);
            var currentQuantity = parseInt(quantityInput.val());

            if (currentQuantity > 1) {
                var newQuantity = currentQuantity - 1;
                quantityInput.val(newQuantity);
                updateAmounts(id, newQuantity, false); // Update amounts for desktop
                Calculate(id);
            }
        });

        // Handle Plus Button Click
        $j("input[name='CalculatePlus']").on('click', function () {
            var id = $j(this).data("value");
            var quantityInput = $j('#txtQuatntity_' + id);
            var currentQuantity = parseInt(quantityInput.val());
            var maxQuantity = parseInt($j('#NoOfRoomsLeft_' + id).val()) || Infinity;

            if (currentQuantity < maxQuantity) {
                var newQuantity = currentQuantity + 1;
                quantityInput.val(newQuantity);
                updateAmounts(id, newQuantity, false); // Update amounts for desktop
                Calculate(id);
            }
        });


        $j("input[name='CalculateMobMinus']").on('click', function (e) {
            var id = $j(this).data("value");
            var quantityInput = $j('#txtMobQuatntity_' + id);
            var currentQuantity = parseInt(quantityInput.val());

            if (currentQuantity > 1) {
                var newQuantity = currentQuantity - 1;
                quantityInput.val(newQuantity);

                // Update the prices based on the new quantity
                var normalPricePerUnit = parseInt($j('#hdNormalMobPrice_' + id).val());
                var discountedPricePerUnit = parseInt($j('#hdDiscountedMobPrice_' + id).val());

                var totalAmount = normalPricePerUnit * newQuantity;
                var discountedAmount = discountedPricePerUnit * newQuantity;

                var noOfNights = @ViewBag.NoOfDays || @Html.Raw(ViewBag.NoOfDays ?? 1);
                var nightsText = noOfNights == 1 ? "Night" : "Nights";

                // Update the displayed prices
                $("#spNormalMobPrice_" + id).html('Rs. ' + totalAmount + ' for ' + noOfNights + ' ' + nightsText);
                $("#spDiscountedMobPRice_" + id).html('Rs. ' + discountedAmount + ' for ' + noOfNights + ' ' + nightsText + (noOfNights > 1 ? '<br><small style="color: #666; font-size: 12px;">(Rs.' + Math.round(discountedAmount / noOfNights) + ' per night)</small>' : ''));
            }

            Calculate(id);
        });

        $j("input[name='CalculateMobPlus']").on('click', function (e) {
            var id = $j(this).data("value");
            var quantityInput = $j('#txtMobQuatntity_' + id);
            var currentQuantity = parseInt(quantityInput.val());
            var maxQuantity = parseInt($j('#NoOfRoomsLeft_' + id).val());

            if (currentQuantity < maxQuantity) {
                var newQuantity = currentQuantity + 1;
                quantityInput.val(newQuantity);

                // Update the prices based on the new quantity
                var normalPricePerUnit = parseInt($j('#hdNormalMobPrice_' + id).val());
                var discountedPricePerUnit = parseInt($j('#hdDiscountedMobPrice_' + id).val());

                var totalAmount = normalPricePerUnit * newQuantity;
                var discountedAmount = discountedPricePerUnit * newQuantity;

                var noOfNights = @ViewBag.NoOfDays || @Html.Raw(ViewBag.NoOfDays ?? 1);
                var nightsText = noOfNights == 1 ? "Night" : "Nights";

                // Update the displayed prices
                $("#spNormalMobPrice_" + id).html('Rs. ' + totalAmount + ' for ' + noOfNights + ' ' + nightsText);
                $("#spDiscountedMobPRice_" + id).html('Rs. ' + discountedAmount + ' for ' + noOfNights + ' ' + nightsText + (noOfNights > 1 ? '<br><small style="color: #666; font-size: 12px;">(Rs.' + Math.round(discountedAmount / noOfNights) + ' per night)</small>' : ''));
            }

            Calculate(id);
        });

        // Function to update displayed amounts based on room quantity and version (desktop/mobile)
        function updateAmounts(id, quantity, isMobile) {
            var normalPricePerUnit = parseInt($j(isMobile ? '#hdNormalMobPrice_' + id : '#hdNormalPrice_' + id).val());
            var discountedPricePerUnit = parseInt($j(isMobile ? '#hdDiscountedMobPrice_' + id : '#hdDiscountedPrice_' + id).val());

            var totalAmount = normalPricePerUnit * quantity;
            var discountedAmount = discountedPricePerUnit * quantity;

            // Get the number of nights from ViewBag instead of parsing HTML
            var noOfNights = @ViewBag.NoOfDays || @Html.Raw(ViewBag.NoOfDays ?? 1);
            var nightsText = noOfNights == 1 ? "Night" : "Nights";

            $j(isMobile ? "#spNormalMobPrice_" + id : "#spNormalPrice_" + id).html('Rs. ' + totalAmount + ' (' + quantity + ' rooms, ' + noOfNights + ' ' + nightsText.toLowerCase() + ')');
            $j(isMobile ? "#spDiscountedMobPRice_" + id : "#spDiscountedPRice_" + id).html('Rs. ' + discountedAmount + ' (' + quantity + ' rooms, ' + noOfNights + ' ' + nightsText.toLowerCase() + ')');
        }

        function Calculate(_Id) {
            var TotalRooms = 0;
            var GrandTotal = 0;
            var RoomCate = "";
            var _RoomCateRoomNums = '';
            var _RatePlanID = '';
            var _RoomRates = '';
            var _RoomRatesN = '';
            var flag = 0;
            var isMobile = $j(window).width() <= 768; // Check if it's a mobile screen

            // Room category
            var _roomCate = $j('#hdRoomCate_' + _Id).val();
            var roomCateRoomNums = $j('#txtQuatntity_' + _Id).val();
            
            // Debug: Log the values being calculated
            console.log('Calculate called for ID:', _Id, 'Room quantity:', roomCateRoomNums);

            // Set RoomRates and RatePlanID for mobile or PC
            var roomQuantity = parseInt($j("#txtQuatntity_" + _Id).val());
            var discountedPricePerUnit, normalPricePerUnit;
            
            if (isMobile) {
                discountedPricePerUnit = parseInt($j('#hdDiscountedMobPrice_' + _Id).val());
                normalPricePerUnit = parseInt($j('#hdNormalMobPrice_' + _Id).val());
                // Price already includes nights, just multiply by room quantity
                _RoomRates = (discountedPricePerUnit * roomQuantity);
                _RoomRatesN = (normalPricePerUnit * roomQuantity);
            } else {
                discountedPricePerUnit = parseInt($j('#hdDiscountedPrice_' + _Id).val());
                normalPricePerUnit = parseInt($j('#hdNormalPrice_' + _Id).val());
                // Price already includes nights, just multiply by room quantity
                _RoomRates = (discountedPricePerUnit * roomQuantity);
                _RoomRatesN = (normalPricePerUnit * roomQuantity);
            }

            // Extract RatePlanID
            var _ratePlanID = $j('#RatePlanID_' + _Id).attr('id');
            _ratePlanID = _ratePlanID.split('_');
            _ratePlanID = _ratePlanID[1];
            _RatePlanID = _ratePlanID;

            // For single room type selection, set values directly (not accumulate)
            TotalRooms = roomQuantity;
            
            if (isMobile) {
                // GrandTotal calculation for mobile version - price already includes nights
                GrandTotal = (discountedPricePerUnit * roomQuantity);
            } else {
                // GrandTotal calculation for PC version - price already includes nights
                GrandTotal = (discountedPricePerUnit * roomQuantity);
            }

            // Update values for single room type
            RoomCate = _roomCate;
            _RoomCateRoomNums = roomCateRoomNums;

            // Set hidden fields for submission
            $j('#RatePlanIDs').val(_RatePlanID);
            $j('#hdTotalRooms').val(TotalRooms);
            $j('#hdTotalAmount').val(GrandTotal);
            $j('#_TotalRooms').html(TotalRooms);
            $j('#_TotalAmount').html(GrandTotal);
            $j('#_TotalRooms1').html(TotalRooms);
            $j('#_TotalAmount1').html(GrandTotal);
            $j('#RoomCatCode').val(RoomCate);
            $j('#RoomCateRoomNums').val(_RoomCateRoomNums);
            $j('#RoomRates').val(_RoomRates);
            
            // Debug: Log the final values being set
            console.log('Final values - TotalRooms:', TotalRooms, 'GrandTotal:', GrandTotal, 'RoomCateRoomNums:', _RoomCateRoomNums);

            flag = 1;

            // Show an alert if no rooms are selected
            if (GrandTotal == 0) {
                alert("Please select at least one room.");
            }
        }

        $j("input[name='ShowDetails']").click(function () {
            var _id = $j(this).attr('id');
            _id = _id.split('_');
            _id = _id[1];

            $j("#SelectRoom_" + _id).prop("checked", true);
            // $j("#RemoveRooms_" + _id).show();
            Calculate(_id);
        });

        $j("input[name='RemoveRooms']").click(function () {
            var _id = $j(this).attr('id');
            _id = _id.split('_');
            _id = _id[1];

            $j("#SelectRoom_" + _id).prop("checked", false);

            Calculate(_id);
            $j("#RemoveRooms_" + _id).hide();
        });


        $('#OpenModal').click(function () {
            $('#myModal').modal('show');
            $("#sticky").hide();
        });

        $('#closemodal').click(function () {
            $('#myModal').modal('hide');
            $("#sticky").show();
        });

        $('#closepicmodal').click(function () {
            $('#carouselModal').modal('hide');
        });

        $('#closepolicymodal').click(function () {
            $('#policyModal').hide();
        });

        $j("#dvPolicy a").click(function () {

            var _id = $j(this).attr('id');
            _id = _id.split('_');
            _id = _id[1];

            try {
                $.ajax({
                    url: '/SearchResult/RoomPolicy',
                    type: 'GET',
                    dataType: 'json',
                    contentType: 'application/json',
                    data: '&CancellationPolicy=' + _id,
                    success: function (data) {
                        $("#policyName").empty();
                        $("#Breakfst").empty();
                        $("#CancellationPolicy").empty();
                        $("#FreeCancelBefore").empty();
                        $("#GuestChargedForCancellation").empty();
                        $("#ChargedForNoShow").empty();
                        // alert(_id)
                        // console.log(data);
                        if (data.length > 0) {
                            $.each(data, function (i, item) {
                                if (i == 0) {
                                    $("#policyName").append(item.RatePlanName);

                                    if (item.Breakfst == 1) {
                                        $("#Breakfst").append("Included");
                                    }
                                    else {
                                        $("#Breakfst").append("Not Included");
                                    }

                                    $("#CancellationPolicy").append(item.CancellationPolicy);

                                    if (item.ChargedForNoShow == 1) {
                                        $("#ChargedForNoShow").append("Same as the cancellation fee");
                                    }
                                    else {
                                        $("#ChargedForNoShow").append("100% of the total price");
                                    }

                                    if (item.FreeCancelBefore == 1) {
                                        $("#FreeCancelBefore").append("The cost of the first night");
                                    }
                                    else if (item.FreeCancelBefore == 2) {
                                        $("#FreeCancelBefore").append("50% of the total price");
                                    }
                                    else {
                                        $("#FreeCancelBefore").append("100% of the total price");
                                    }


                                    if (item.HowlongFreeOfCharge == 1) {
                                        $("#GuestChargedForCancellation").append("until 6:00PM on the day of arrival");
                                    }
                                    else if (item.HowlongFreeOfCharge == 2) {
                                        $("#GuestChargedForCancellation").append("until 2:00PM on the day of arrival");
                                    }
                                    else if (item.HowlongFreeOfCharge == 3) {
                                        $("#GuestChargedForCancellation").append("until 1 day before arrival");
                                    }
                                    else if (item.HowlongFreeOfCharge == 4) {
                                        $("#GuestChargedForCancellation").append("until 2 days before arrival");
                                    }
                                    else if (item.HowlongFreeOfCharge == 5) {
                                        $("#GuestChargedForCancellation").append("until 3 days before arrival");
                                    }
                                    else if (item.HowlongFreeOfCharge == 6) {
                                        $("#GuestChargedForCancellation").append("until 5 days before arrival");
                                    }
                                    else if (item.HowlongFreeOfCharge == 7) {
                                        $("#GuestChargedForCancellation").append("until 7 days before arrival");
                                    }
                                    else if (item.HowlongFreeOfCharge == 8) {
                                        $("#GuestChargedForCancellation").append("until 14 days before arrival");
                                    }
                                    else if (item.HowlongFreeOfCharge == 9) {
                                        $("#GuestChargedForCancellation").append("until 21 days before arrival");
                                    }
                                    else if (item.HowlongFreeOfCharge == 10) {
                                        $("#GuestChargedForCancellation").append("until 28 days before arrival");
                                    }
                                    else if (item.HowlongFreeOfCharge == 11) {
                                        $("#GuestChargedForCancellation").append("until 30 days before arrival");
                                    }
                                    else if (item.HowlongFreeOfCharge == 12) {
                                        $("#GuestChargedForCancellation").append("until 42 days before arrival");
                                    }
                                    else if (item.HowlongFreeOfCharge == 13) {
                                        $("#GuestChargedForCancellation").append("until 60 days before arrival");
                                    }
                                    else {
                                        $("#FreeCancelBefore").append("No Free Cancellation");
                                    }

                                    $j("#policyModal").show();
                                }
                            });
                        }
                    },
                    error: function (err) {
                        alert(err.status + " : " + err.statusText);
                    }

                });
            } catch (e) {
                alert(e.status + " : " + e.statusText);
                // window.location.href = '/Booking/BookingList';
            }
        });
    });
</script>
