@using HotelWebsite.Models;

@{
    ViewBag.Title = "Maisonette Murree Hotel | Available Rooms";
    ViewBag.keywords = "Hotel at Muree";
    ViewBag.Description = "Maisonette Hotel at Murree is the best place to stay. Our hotel in Murree Pakistan offers luxurious rooms, equipped with all the amenities. Book Online.";
    var CancelPolicy = new List<CancellationPolicy>();
    List<PropertySearch> results = new List<PropertySearch>();
    int? roomPrice = 0;
    string _CheckIn = Request.QueryString["CheckIn"] ?? ""; // Default to empty string
    string _CheckOut = Request.QueryString["CheckOut"] ?? ""; // Default to empty string
    int _adults = Convert.ToInt32(Request.QueryString["Adults"] ?? "1"); // Default to 1
    int _children = Convert.ToInt32(Request.QueryString["Children"] ?? "0"); // Default to 0
    int _NoOfRooms = Convert.ToInt32(Request.QueryString["NoOfRooms"] ?? "1"); // Default to 1

    int _TotalPax = _adults + _children;
    int NoOfDays = Convert.ToInt32(ViewBag.NoOfDays ?? 1);

    if (_TotalPax == 0)
    {
        _TotalPax = 1;
    }

    if (Session["results"] != null)
    {
        results = (List<PropertySearch>)Session["results"];
    }
}


