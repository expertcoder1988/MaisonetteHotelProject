@using HotelWebsite.Models
@{
    ViewBag.Title = "Booking Receipt";
    Layout = "~/Views/Shared/_Layout.cshtml";
    // Retrieve booking and confirmationId from session

    //List<HotelWebsite.Controllers.FinalBooking> booking = Session["booking"] as List<HotelWebsite.Controllers.FinalBooking>;
    //string confirmationId = Session["confirmationId"] as string;

    //List<HotelWebsite.Models.Pictures> roomPictures = TempData["roomPictures"] as List<HotelWebsite.Models.Pictures>;

    List<HotelWebsite.Controllers.FinalBooking> booking = (List<HotelWebsite.Controllers.FinalBooking>)Session["booking"];
    List<HotelWebsite.Models.Pictures> roomPictures = (List<HotelWebsite.Models.Pictures>)TempData["roomPictures"];
    string confirmationId = Convert.ToString(Session["confirmationId"]);

    //var GrandTotal = booking.Sum(x => x.TotalRoomRate ?? 0);

    string PaxName = "";
    string _checkin = Convert.ToDateTime(booking[0].CheckIn).ToShortDateString();
    string _checkout = Convert.ToDateTime(booking[0].CheckOut).ToShortDateString();

    // Retrieve RoomPicture from Session
    string roomPicture = Session["ImagePath"] as string;
    ViewBag.RoomPicture = !string.IsNullOrEmpty(roomPicture) ? roomPicture : "default-image.jpg";



    if (Session["confirmationId"] != null)
    {
        PaxName = booking[0].PaxTitle + " " + booking[0].PaxFName + " " + booking[0].PaxLName;
    }
    else
    {
        confirmationId = "";
    }
}

