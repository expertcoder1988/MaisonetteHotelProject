
@{
    ViewBag.Title = "Room Amenities";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="box-header with-border">
    <h3 class="callout callout-info" style="text-align: center; font-weight: bold; font-size: 20px">Upload Hotel Amenities</h3>
</div>


<input type="hidden" id="AvoidReload" value="false" />
<div class="box-body">
    <div class="row">
        <div class="col-md-12">
            <div class="form-group">
                <div class="col-md-6">
                    <label id="lblProduct">
                        Please Select Property
                    </label>
                    <select ID="ddlProperty" class="form-control">
                    </select>
                </div>
                <div class="col-md-6">
                    <label id="lblProduct">
                        Please Select Room
                    </label>
                    <select ID="rooms" class="form-control">
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="">
        <div class="col-md-6">
            <label id="lblProduct">
                Please Select Icon
            </label>
            <select ID="RoomIcons" class="form-control">
            </select>
        </div>
        <div class="col-12 col-md-6">
            <div class="form-group">
                <label for="Name">Amenity Name</label>
                <input type="text" id="AmenityName" class="form-control" name="AmenityName" />
            </div>
        </div>
    </div>

    <div align="center">
        <input type="button" class="btn btn-primary" id="AmenityData" value="Save Data" />
    </div>

</div>
<div class="box-body">

    <div class="row">
        <div class="col-md-8 col-xs-12">
            <table class="table" id="images">
                <tr>
                    <th>S No.</th>
                    <th>Icon</th>
                    <th>Description</th>
                    <th></th>
                </tr>
                <tbody>
                </tbody>
            </table>
        </div>
    </div>
</div>


<script src="~/Content/plugins/jQuery/jquery-2.2.3.min.js"></script>
<script src="~/Scripts/EntityScript/RoomAmenities.js"></script>