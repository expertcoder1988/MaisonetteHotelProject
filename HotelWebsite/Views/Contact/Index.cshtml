<script>// Function to increment the value
    function increment(fieldId) {
        const field = document.getElementById(fieldId);
        let value = parseInt(field.value);
        if (!isNaN(value)) {
            field.value = value + 1;
        } else {
            field.value = 1;
        }
    }

    // Function to decrement the value
    function decrement(fieldId) {
        const field = document.getElementById(fieldId);
        let value = parseInt(field.value);
        if (!isNaN(value) && value > 0) {
            field.value = value - 1;
        } else {
            field.value = 0;
        }
    }</script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Initialize Flatpickr for Check-in
        flatpickr("#checkin", {
            dateFormat: "Y-m-d", // Adjust the format as needed
            minDate: "today", // Prevent selecting past dates
            onChange: function (selectedDates, dateStr, instance) {
                // Set the minimum date for Check-out
                const checkout = document.getElementById("checkout")._flatpickr;
                checkout.set("minDate", dateStr);
            }
        });

        // Initialize Flatpickr for Check-out
        flatpickr("#checkout", {
            dateFormat: "Y-m-d",
            minDate: "today" // Ensure it starts with today by default
        });
    });



</script>