@using HotelWebsite.Models;

@{

    var blog = (List<Post>)TempData["blog"];
    ViewBag.Title = blog[0].Title;
    ViewBag.MetaDesciption = blog[0].MetaDescription;
}

<main>

    <div class="hero medium-height jarallax" data-jarallax data-speed="0.2">
        <img class="jarallax-img" src="~/content/paradise/img/masionette_about.png" alt="">
        <div class="wrapper opacity-mask d-flex align-items-center justify-content-center text-center animate_hero" data-opacity-mask="rgba(0, 0, 0, 0.5)">
            <div class="container" style="margin-top:12%">
                <h2 class="slide-animated two" style="font-size:34px;color:#fff">Explore Our Blog for Latest Murree Updates</h2>
            </div>
        </div>
    </div>
    <!-- /Background Img Parallax -->

    <div class="container margin_120_95">
        <div class="row justify-content-center">
           
           
                <div class="col-md-8">
                    <div class="box_contents_in">
                        @*<h2 class="mb-4">At vero eos et accusamus et iusto odio dignissimos ducimus qui blanditiis praesentium</h2>*@
                        <figure><img src="~/uploads/blog/@blog[0].DefaultImage" alt="" class="img-fluid"></figure>
                        <div class="container">
                            <small>@blog[0].PublishedDate - by @blog[0].Author</small>
                            <h1 >@blog[0].Title</h1>
                        </div>
                        <p>
                            @Html.Raw(blog[0].Description)

                        </p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="widget-s">
                        <a class="weatherwidget-io" href="https://forecast7.com/en/33d9173d40/murree/" data-label_1="MURREE" data-label_2="WEATHER" data-theme="gray" data-basecolor="#24262d">MURREE WEATHER</a>
                        <script>
                            !function (d, s, id) { var js, fjs = d.getElementsByTagName(s)[0]; if (!d.getElementById(id)) { js = d.createElement(s); js.id = id; js.src = 'https://weatherwidget.io/js/widget.min.js'; fjs.parentNode.insertBefore(js, fjs); } }(document, 'script', 'weatherwidget-io-js');
                        </script>
                    </div>
                </div>

           
            </div>
            <!--/row -->
        </div>
    <!--/container -->

    <!--/bg_white -->

</main>

<script>
    !(function (d, s, id) {
        var js,
            fjs = d.getElementsByTagName(s)[0];
        if (!d.getElementById(id)) {
            js = d.createElement(s);
            js.id = id;
            js.src = "https://weatherwidget.io/js/widget.min.js";
            fjs.parentNode.insertBefore(js, fjs);
        }
    })(document, "script", "weatherwidget-io-js");</script>